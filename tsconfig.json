{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,

    // Keeps `./config.ts` specifiers in the source (so Node can run src/ directly via
    // type stripping) while emitting `./config.js` into dist/. TS 5.7+.
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
