{
  "name": "renderdiff",
  "version": "0.11.0",
  "description": "Visual-parity checker for website migrations: screenshot-diffs your change against a local build of the base (or production) across viewport widths, and names the DOM element and CSS property behind each change. Built for coding agents (Claude Code, Codex, Cursor).",
  "type": "module",
  "license": "MIT",
  "author": "Timur Mashara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmashara/renderdiff.git"
  },
  "homepage": "https://github.com/tmashara/renderdiff#readme",
  "bugs": "https://github.com/tmashara/renderdiff/issues",
  "bin": {
    "renderdiff": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "renderdiff.config.example.ts"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepare": "tsc",
    "test": "node --test tests/unit/*.test.ts",
    "test:visual": "node --test --test-timeout=600000 tests/visual/*.test.ts",
    "test:all": "npm test && npm run test:visual",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt src tests renderdiff.config.example.ts",
    "format:check": "oxfmt --check src tests renderdiff.config.example.ts"
  },
  "keywords": [
    "visual-regression",
    "visual-diff",
    "visual-testing",
    "screenshot-diff",
    "screenshot-comparison",
    "pixel-diff",
    "migration",
    "refactor",
    "css-refactor",
    "framework-migration",
    "parity",
    "playwright",
    "pixelmatch",
    "coding-agent",
    "ai-agent",
    "claude-code",
    "agent-skill",
    "llm"
  ],
  "dependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^5.8.3"
  }
}
